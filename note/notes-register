#!/usr/bin/env bash

set -euo pipefail

NOTES_REGISTER_DEBUG="${NOTES_REGISTER_DEBUG:-0}"
[ "${NOTES_REGISTER_DEBUG}" == "1" ] && set -x

# This script is not supposed to be used directly
DATE_OFFSET="${1:-0}"
NOTES_FOLDER="${2:-Daily}"
DATE_FORMAT_FOR_THIS_SCRIPT="${3:-%d-%m-%Y}"
DATE_FORMAT_CUT_OFFSETS_FOR_THIS_SCRIPT="${4:-2-4}"

NOTES_REGISTER_NOTES_PATH="${NOTES_REGISTER_NOTES_PATH:-${HOME}/Syncthing/Notes/$NOTES_FOLDER}"
mkdir -p "${NOTES_REGISTER_NOTES_PATH}"

TODAY_SEC="$(date +"%s")"
DAY_SEC="86400"
DATE_TARGET="$(date -d "@$(( TODAY_SEC - ( DATE_OFFSET * DAY_SEC ) ))" "+${DATE_FORMAT_FOR_THIS_SCRIPT}")"

if ! find "${NOTES_REGISTER_NOTES_PATH}" -exec basename {} .md \; | cut -f"${DATE_FORMAT_CUT_OFFSETS_FOR_THIS_SCRIPT}" -d- | grep -q -F "${DATE_TARGET}" ; then
    echo "# Note $DATE_TARGET" | tee -a "${NOTES_REGISTER_NOTES_PATH}/Note-${DATE_TARGET}.md"
fi

exec "${EDITOR}" "${NOTES_REGISTER_NOTES_PATH}/Note-${DATE_TARGET}.md"
