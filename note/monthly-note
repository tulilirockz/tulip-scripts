#!/usr/bin/env bash

set -euo pipefail

NOTES_REGISTER_DEBUG="${NOTES_REGISTER_DEBUG:-0}"
[ "${NOTES_REGISTER_DEBUG}" == "1" ] && set -x

NOTE_REGISTER_MONTHLY_NOTE_OFFSET="${NOTE_REGISTER_MONTHLY_NOTE_OFFSET:-${1:-0}}"
shift
NOTE_REGISTER_MONTHLY_NOTE_FOLDER="${NOTE_REGISTER_MONTHLY_NOTE_FOLDER:-Monthly}"
DAY_TO_MONTH_OFFSET_NUMBER=28

notes-register "$(( NOTE_REGISTER_MONTHLY_NOTE_OFFSET * DAY_TO_MONTH_OFFSET_NUMBER ))" "${NOTE_REGISTER_MONTHLY_NOTE_FOLDER}" %m-%Y 2-3 
