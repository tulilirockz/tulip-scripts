#!/usr/bin/env bash

set -euo pipefail

NOTES_REGISTER_DEBUG="${NOTES_REGISTER_DEBUG:-0}"
[ "${NOTES_REGISTER_DEBUG}" == "1" ] && set -x

NOTES_REGISTER_DAILY_NOTE_OFFSET="${NOTES_REGISTER_DAILY_NOTE_OFFSET:-${1:-0}}"
NOTES_REGISTER_DAILY_NOTE_FOLDER="${NOTES_REGISTER_DAILY_NOTE_FOLDER:-Daily}"

notes-register "${NOTES_REGISTER_DAILY_NOTE_OFFSET}" "${NOTES_REGISTER_DAILY_NOTE_FOLDER}" "%d-%m-%Y"
