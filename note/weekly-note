#!/usr/bin/env bash

set -euo pipefail

NOTES_REGISTER_DEBUG="${NOTES_REGISTER_DEBUG:-0}"
[ "${NOTES_REGISTER_DEBUG}" == "1" ] && set -x

NOTES_REGISTER_WEEKLY_NOTE_OFFSET="${NOTES_REGISTER_WEEKLY_NOTE_OFFSET:-${1:-0}}"
NOTES_REGISTER_WEEKLY_NOTE_FOLDER="${NOTES_REGISTER_WEEKLY_NOTE_FOLDER:-Weekly}"
DAY_TO_WEEK_OFFSET_NUMBER=7

notes-register "$(( NOTES_REGISTER_WEEKLY_NOTE_OFFSET * DAY_TO_WEEK_OFFSET_NUMBER ))" "${NOTES_REGISTER_WEEKLY_NOTE_FOLDER}" "%U-%Y" "2-3" 
