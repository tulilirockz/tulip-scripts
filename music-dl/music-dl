#!/usr/bin/env bash

set -euo pipefail

MUSIC_DL_DEBUG="${MUSIC_DL_DEBUG:-0}"
[ "${MUSIC_DL_DEBUG}" == "1" ] && set -x

MUSIC_DL_LIBRARY_PATH="${MUSIC_DL_LIBRARY_PATH:-"./"}"
MUSIC_DL_FOLDER_TO_SAVE="${MUSIC_DL_FOLDER_TO_SAVE:-}"

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -c|--channel)
      MUSIC_DL_FOLDER_TO_SAVE="${2-}"
      shift 2
      ;;
    --channel=*)
      MUSIC_DL_FOLDER_TO_SAVE="${1#--channel=}"
      shift
      ;;
    *)
      break
      ;;
  esac
done

if [ -z "${MUSIC_DL_FOLDER_TO_SAVE}" ] ; then
  YT_DLP_OUTPUT_CHANNEL_AND_TITLE="$(yt-dlp --print channel --print title "$1")"
  MUSIC_DL_CHANNEL="$(head -n1 <<< "${YT_DLP_OUTPUT_CHANNEL_AND_TITLE}")"
  MUSIC_DL_TITLE="$(tail -n-1 <<< "${YT_DLP_OUTPUT_CHANNEL_AND_TITLE}" | cut -f1 -d"-")"
  MUSIC_DL_TITLE="${MUSIC_DL_TITLE#[[:space:]]}"
  MUSIC_DL_TITLE="${MUSIC_DL_TITLE%[[:space:]]}"
  if [ "${MUSIC_DL_TITLE}" == "$(tail -n-1 <<< "${YT_DLP_OUTPUT_CHANNEL_AND_TITLE}")" ] ; then
    MUSIC_DL_FOLDER_TO_SAVE="${MUSIC_DL_CHANNEL}"
  fi

  if [ "${MUSIC_DL_TITLE}" == "${MUSIC_DL_CHANNEL}" ] ; then
    MUSIC_DL_FOLDER_TO_SAVE="${MUSIC_DL_CHANNEL}"
  fi

  if [ -z "${MUSIC_DL_FOLDER_TO_SAVE}" ] ; then
    MUSIC_DL_FOLDER_TO_SAVE="$(gum choose --header="Choose what to use as the channel name" "${MUSIC_DL_TITLE}" "${MUSIC_DL_CHANNEL}")"
  fi
fi
mkdir -p "${MUSIC_DL_LIBRARY_PATH}/${MUSIC_DL_FOLDER_TO_SAVE}"

pushd "${MUSIC_DL_LIBRARY_PATH}/${MUSIC_DL_FOLDER_TO_SAVE}"
yt-dlp --embed-metadata --embed-chapters --embed-thumbnail --xattrs -f bestaudio -x --audio-format opus "$@"
popd
